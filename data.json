  "sequences": [
    {
      "id": 1,
      "title": "Field through and the sweeping backhand",
      "description": "From a deeper start, work through the ball, drop-step left to get in front, then sweep the backhand and set your feet."
    },
    {
      "id": 2,
      "title": "Routine and lateral positioning",
      "description": "Field a routine hop, then get in front of balls to your left and right."
    },
    {
      "id": 3,
      "title": "Adjust and crossover shuffles",
      "description": "Close ground and adjust on the routine ball. Drop-step and crossover into the forehand and the backhand."
    },
    {
      "id": 4,
      "title": "Infield-in field-through and shuffles",
      "description": "From an infield-in start, field through the ball, then drop-step and shuffle to either side."
    },
    {
      "id": 5,
      "title": "Slow roller and crossover routes",
      "description": "Charge the two-handed slow roller to your left. Drop-step to get in front, then crossover into the backhand."
    },
    {
      "id": 6,
      "title": "Come-and-get-it and the jump throw",
      "description": "Charge the one-handed routine ball, lengthen the hop on the backhand, then jump-throw on the run."
    },
    {
      "id": 7,
      "title": "Chopper, forehand run, and field-with",
      "description": "Two-hand the chopper above the knee, set your feet on the forehand run, then field with the ball on a deep drop."
    },
    {
      "id": 8,
      "title": "Hinge, charging backhand, and ball right",
      "description": "Hinge into the backhand and gather. Charge the softer backhand and throw on the run, then one-hand the ball to your right and set your feet."
    },
    {
      "id": 9,
      "title": "Boot recovery, ball right, and rake-through",
      "description": "Charge a routine ball, recover the boot barehanded, and arm-fake. Cut the distance on a ball to your right, then rake through a medium-soft backhand."
    },
    {
      "id": 10,
      "title": "Routine gather and urgent charging",
      "description": "Gather on the routine ball. On the do-or-die plays, charge and field with one hand or barehand."
    },
    {
      "id": 11,
      "title": "Chopper, ball-left, and no-step backhand",
      "description": "Charge the one-handed chopper below the knee, close on the ball to your left, and throw without an extra step on the backhand."
    },
    {
      "id": 12,
      "title": "Boot, sit-back, and set feet",
      "description": "Recover a boot and throw. Sit back on the chopper for a quick exchange, then set your feet on the lateral backhand."
    }
  ]
}
